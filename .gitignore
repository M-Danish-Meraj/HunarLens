# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Pytest / coverage / tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Streamlit secrets & local config
.streamlit/secrets.toml

# Private microdata & individual-level processed/split records (§4.1, §6.4, §13)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*.csv
data/splits/*.parquet
!data/splits/.gitkeep

# Private individual-level test predictions & intermediate search binaries
reports/metrics/private_*
models/candidates/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

